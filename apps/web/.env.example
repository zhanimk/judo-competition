# Vercel: set these before building. Keep API requests on the web origin.
API_INTERNAL_URL=https://your-api.onrender.com
# HTTPS long-polling through the same-origin rewrite preserves HttpOnly cookies.
NEXT_PUBLIC_LIVE_TRANSPORT=polling
# Leave NEXT_PUBLIC_LIVE_URL unset for Vercel + Render with different domains.
# Local Docker/LAN deployments default to WebSocket without these overrides.
