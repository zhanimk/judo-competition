# Copy privately to .env.production at the repository root; chmod 600.
# Generate three different passwords with: openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=
APP_DATABASE_PASSWORD=
REDIS_PASSWORD=
PUBLIC_ORIGIN=https://judo.example.kz
COOKIE_SECURE=true
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
JUDO_IMAGE_TAG=local
# A private 0600 regular file containing 64 hex characters; create separately, never put the key here.
BACKUP_ENCRYPTION_KEY_SOURCE=./deploy/secrets/backup.key
